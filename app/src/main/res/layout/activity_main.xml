<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wi-Fi ve Ethernet Kontrol"
        android:textSize="36sp" />

    <Button
        android:id="@+id/btnKes"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:focusable="true"
        android:text="KES (Wi-Fi + Ethernet kapat)"
        android:textSize="24sp">
        <requestFocus />
    </Button>

    <Button
        android:id="@+id/btnAc"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:focusable="true"
        android:text="AÇ (Wi-Fi + Ethernet aç)"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btnSsh"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:focusable="true"
        android:text="SSH AÇ / KAPAT (root)"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/txtDurum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Hazır"
        android:textSize="22sp" />

</LinearLayout>
